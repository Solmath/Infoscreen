FLASK_APP=infoscreen:create_app
FLASK_DEBUG=1

# Placeholders: replace with your transit operator's EFA endpoint, place,
# comma-separated stations, and timezone. Real location data belongs in a
# deployment's own env file, never committed here.
EFA_URL=https://efa.example.com/some-authority
EFA_PLACE=ExampleCity
EFA_STATIONS=Station A,Station B
EFA_TIMEZONE=Europe/Berlin
