FLASK_APP=infoscreen.app:create_app
FLASK_DEBUG=0

# EFA_URL: base URL of your transit operator's EFA endpoint (e.g. one
# found via https://www.efa.de/), WITHOUT the trailing /XML_DM_REQUEST.
EFA_URL=https://efa.example.com/some-authority
# EFA_PLACE: the place/city passed to the EFA API alongside a station name.
EFA_PLACE=ExampleCity
# EFA_STATIONS: comma-separated allowlist of selectable stations.
EFA_STATIONS=Station A,Station B
# EFA_TIMEZONE: IANA timezone name used to query current departures.
EFA_TIMEZONE=Europe/Berlin
